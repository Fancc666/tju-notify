# ===== 天津大学统一认证 =====
USER_NAME=YOUR_STUDENT_ID
USER_PWD=YOUR_PASSWORD

# ===== 邮件通知（SMTP）=====
SMTP_SERVER=smtp.qq.com
SMTP_USER=you@qq.com
SMTP_PASSWORD=your_smtp_auth_code
# 端口 未加密587 SSL加密465
SMTP_PORT=587
ADMIN_MAIL=you@qq.com

# ===== 调度 =====
# cron 表达式，默认每小时整点；置空则改用下面的固定间隔
POLL_CRON=0 6-23 * * *
# CRON 为空时生效，固定间隔请求，单位分钟
POLL_INTERVAL_MINUTES=60
# 首次启动且数据库为空时，是否静默灌入历史通知，1 开 0 关
BOOTSTRAP_ON_START=1

# ===== 接口 / 存储（无需修改）=====
# 一次拉取多少条
LIMIT_SIZE=30
# 请求超时（秒）与失败重试次数
REQUEST_TIMEOUT=20
MAX_RETRY=3
# 数据库路径，默认 data/history.db
DB_PATH =
# 邮件正文中单条通知的正文截断长度，0 表示不截断
MAIL_CONTENT_LIMIT=2000
# 入库正文截断长度，0 表示不截断
STORE_CONTENT_LIMIT=0
